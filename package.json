{
  "name": "pi-infinity",
  "version": "0.1.0",
  "description": "Infinity runtime design practices for pi: non-blocking work, durable timers, threads, sandboxes",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "check": "./check.bash",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "fmt": "prettier --write ."
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.4.0",
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@earendil-works/pi-tui": "^1.4.0",
    "@types/node": "^24.0.0",
    "prettier": "^3.9.10",
    "typebox": "1.3.27",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "extensions",
    "agents",
    "scripts",
    "SPEC.md",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  }
